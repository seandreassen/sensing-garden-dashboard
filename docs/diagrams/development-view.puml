@startuml development-view
title Development view — file-level dependencies

skinparam packageStyle folder
skinparam linetype ortho
top to bottom direction

' ---------- src/ ----------
package "src/" as src #ffffff {

  package "Entry & config" as entry #E3F2FD {
    [main.tsx] as main
    [env.ts] as env
    [routeTree.gen.ts] as tree
    [index.css · assets/] as misc

    main -[hidden]- env
    env -[hidden]- tree
    tree -[hidden]- misc
  }

  package "routes/" as routes #F3E5F5 {
    [__root.tsx] as rRoot
    [index.tsx\n(landing)] as rLanding
    [_filterLayout.tsx] as rLayout
    [overview.tsx] as rOverview
    [analytics.tsx] as rAnalytics
    [observations.tsx] as rObservations
    [info.tsx] as rInfo
    [edit.tsx] as rEdit

    rRoot -[hidden]- rLanding
    rLanding -[hidden]- rLayout
    rLayout -[hidden]- rOverview
    rOverview -[hidden]- rAnalytics
    rAnalytics -[hidden]- rObservations
    rObservations -[hidden]- rInfo
    rInfo -[hidden]- rEdit
  }

  package "components/" as comps #E8F5E9 {
    [ui/\nshadcn / Base UI] as cUi
    [landingPage/] as cLanding
    [deploymentLayout/] as cLayout
    [overview/] as cOverview
    [analytics/] as cAnalytics
    [observations/] as cObservations
    [info/] as cInfo
    [map/] as cMap
    [deploymentEditor/] as cEditor
    [filters/] as cFilters
    [Shared\nRootHeader · ExportData · NotFound] as cShared

    cUi -[hidden]- cLanding
    cLanding -[hidden]- cLayout
    cLayout -[hidden]- cOverview
    cOverview -[hidden]- cAnalytics
    cAnalytics -[hidden]- cObservations
    cObservations -[hidden]- cInfo
    cInfo -[hidden]- cMap
    cMap -[hidden]- cEditor
    cEditor -[hidden]- cFilters
    cFilters -[hidden]- cShared
  }

  package "lib/" as lib #FFF3E0 {
    [hooks/] as hooks
    [utils/] as utils
    [types/api.ts] as types

    hooks -[hidden]- utils
    utils -[hidden]- types
  }

  entry -[hidden]- routes
  routes -[hidden]- comps
  comps -[hidden]- lib
}

' ' ---------- tests/ ----------
' package "tests/" as tests #FCE4EC {
'   [unit/] as tUnit
'   [component/] as tComp
'   [e2e/] as tE2E

'   tUnit -[hidden]- tComp
'   tComp -[hidden]- tE2E
' }

' ---------- Entry ----------
main --> tree
main --> env
tree --> rRoot

' ---------- Route -> Component dependencies ----------
rRoot --> cShared
rLanding --> cLanding
rLanding --> cShared
rLanding --> cUi
rLayout --> cLayout
rLayout --> cShared
rOverview --> cOverview
rAnalytics --> cAnalytics
rObservations --> cObservations
rInfo --> cInfo
rInfo --> cMap
rEdit --> cEditor
rEdit --> cMap

' Filter row used inside the deployment layout
cLayout --> cFilters

' ---------- Route -> hooks ----------
rLanding --> hooks
rLayout --> hooks
rOverview --> hooks
rAnalytics --> hooks
rObservations --> hooks
rEdit --> hooks

' ---------- Component -> ui / hooks / utils ----------
cLanding --> cUi
cLayout --> cUi
cOverview --> cUi
cAnalytics --> cUi
cObservations --> cUi
cInfo --> cUi
cEditor --> cUi
cFilters --> cUi
cMap --> cUi

cOverview --> hooks
cAnalytics --> hooks
cObservations --> hooks
cInfo --> hooks
cEditor --> hooks
cFilters --> hooks

cAnalytics --> utils
cObservations --> utils
cFilters --> utils
cMap --> utils

' ---------- lib internals ----------
hooks --> utils
hooks --> types
hooks --> env


@enduml
