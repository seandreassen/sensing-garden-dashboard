@startuml development-view
title Development view — source code organization

skinparam packageStyle folder
skinparam linetype ortho
top to bottom direction

' ---------- Repo root ----------
package "Repo root" as root {
  [vite.config.ts\ntsconfig.*\nplaywright.config.ts\nvitest.config.ts\n.oxlintrc.json\n.oxfmtrc.json] as cfg
  [package.json\npnpm-lock.yaml] as pkg
}

' ---------- src/ ----------
package "src/" as src {

  package "Entry & config" as entry {
    [main.tsx] as main
    [env.ts] as env
    [routeTree.gen.ts\n(auto-generated)] as tree
    [index.css] as css
    [assets/] as assets
  }

  package "routes/" as routes {
    [__root.tsx] as rroot
    [index.tsx\n(landing)] as rindex
    package "deployment/$deploymentId/" as rdep {
      [_filterLayout.tsx] as rlayout
      [overview.tsx · analytics.tsx\nobservations.tsx · info.tsx\nedit.tsx · index.tsx] as rtabs
      [$.tsx\n(catch-all)] as rcatch
    }
  }

  package "components/" as comps {

    package "ui/ (shadcn / Base UI)" as uikit {
      [Button · Card · Dialog\nTable · Popover · Select\nSlider · Tooltip · ...] as uiPrims
    }

    package "Feature folders" as feats {
      [landingPage/\nDeploymentGrid, HeroCarousel] as fLanding
      [deploymentLayout/\nHeader, Tabs, FiltersRow] as fLayout
      [overview/\nTotalInsectCount, SpeciesRichness,\nTopTaxa, Observations] as fOverview
      [analytics/\nActivityHeatmap, AirPollution,\nAirQualityIndices, TaxaTreemap,\nEnvironmentalConditions] as fAnalytics
      [observations/\nDataTable, Columns,\nObservationRowDialog,\nobservationDialog/] as fObs
      [info/\nDeploymentInfo, Devices] as fInfo
      [map/\nGoogleMaps, MapWithDrop,\nGoogleMapsCard, PinIcon] as fMap
      [deploymentEditor/\nEdit cards] as fEditor
      [filters/\nDateRange, Hub,\nTaxonomy, Confidence] as fFilters
      [deployments/] as fDeployments
    }

    package "Shared (top-level)" as shared {
      [RootHeader.tsx] as sHeader
      [ExportData.tsx] as sExport
      [NotFound.tsx] as sNotFound
    }
  }

  package "lib/" as lib {
    [hooks/\nuseDeployments, useDeployment,\nuseObservations, useObservationsTimeSeries,\nuseEnvironment, useEnvironmentTimeSeries,\nuseTaxaCount, useObservationCount,\nuseFilters, useDeploymentMutations,\nuseDeviceMutations, useScrollDirection] as hooks
    [utils/\nfilters, queryParameters, heatmap,\ntimeSeries, location, headers, index] as utils
    [types/\napi.ts] as types
  }
}

' ---------- tests/ ----------
package "tests/" as tests {
  [unit/\n(vitest — utils)] as tUnit
  [component/\n(vitest-browser-react)] as tComp
  [e2e/\n(playwright)] as tE2E
  [render.tsx\n(test helper)] as tRender
}

' ---------- Dependencies ----------
main --> env
main --> tree
tree --> routes

routes --> feats
routes --> shared
routes --> hooks

feats --> uikit
feats --> hooks
feats --> utils
shared --> uikit

hooks --> utils
hooks --> types
hooks --> env

tests ..> src : exercises

@enduml
