@startuml process-view
title Process view — startup, navigation, filtering

actor "User" as U
participant "Browser /\nReact" as B
participant "TanStack\nRouter" as R
participant "TanStack\nQuery Cache" as Q
participant "Sensing\nGarden API" as API
participant "Google\nMaps" as GM

autonumber

U -> B : Loads / (root)
B -> R : Matches route "/"
R -> B : Render index.tsx
B -> Q : useDeployments()
Q -> API : GET /deployments?limit=100
API --> Q : JSON deployments
Q --> B : Cached data
B --> U : Renders DeploymentGrid

U -> B : Clicks deployment
B -> R : Navigate /deployment/:id/overview
R -> B : Render _filterLayout + overview

group Parallel fetching
  B -> Q : useObservationsTimeSeries
  Q -> API : GET /classifications/time_series
  B -> Q : useTaxaCount
  Q -> API : GET /classifications/taxa_count
  B -> Q : useObservationCount
  Q -> API : GET /classifications/count
end
API --> Q : Responses
Q --> B : Data
B --> U : Renders cards + charts
@enduml
