@startuml scenario-b-filter
title Scenario B — Filter observations

actor User as U
participant "FiltersRow" as UI
participant "useFilters" as F
participant "Router" as R
participant "Query cache" as Q
participant "API" as API

U -> UI : Sets date, hub, confidence
UI -> F : updateFilters(...)
F -> R : navigate(search=..., replace=true)
R -> F : New search state
F --> Q : New queryKeys -> refetch
Q -> API : GET /classifications\n(new params)
API --> Q : Filtered observations
Q --> UI : Table re-renders
@enduml
