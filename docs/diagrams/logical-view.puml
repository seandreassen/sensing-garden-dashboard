@startuml logical-view
title Logical view — key abstractions

skinparam componentStyle rectangle
skinparam packageStyle rectangle
top to bottom direction

' ---------- Presentation layer ----------
package "Presentation" as Pres {
  [Landing] as Landing
  [Deployment dashboard] as Dashboard
  [Filters] as Filters
}

' ---------- Domain layer ----------
package "Domain" as Domain {
  [Deployment] as Deployment
  [Hub] as Hub
  [Observation] as Observation
  [Environmental reading] as EnvReading

  Deployment "1" o-- "1..*" Hub
  Hub "1" --> "*" Observation
  Hub "1" --> "*" EnvReading
}

' ---------- Data layer ----------
package "Data" as Data {
  [Sensing Garden\ndata source] as Source
}

' ---------- Layer relationships ----------
Landing ..> Deployment
Dashboard ..> Deployment
Dashboard ..> Hub
Dashboard ..> Observation
Dashboard ..> EnvReading
Filters ..> Observation

Deployment ..> Source
Hub ..> Source
Observation ..> Source
EnvReading ..> Source

@enduml
